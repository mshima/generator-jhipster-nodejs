import { Controller, ClassSerializerInterceptor, Get, Req, UseGuards, UseInterceptors } from '@nestjs/common';
import { Pageable } from '../common/database/pageable.ts';
import { PageRequest, Page } from '../common/database/pagination.entity.ts';
import { PublicUserDTO } from './dto/user.dto.ts';
import { AuthGuard } from '../auth/index.ts';
import { Request } from '../common/request.ts';
import { HeaderUtil } from '../common/header-util.ts';
import { ApiTags, ApiResponse, ApiOperation } from '@nestjs/swagger';
import { UserService } from './user.service.ts';

// The properties the public user list can be sorted on, like the PublicUserResource of JHipster Spring Boot. Exported: the
// no-useless-assignment rule of ESLint does not see its use in a parameter decorator.
export const ALLOWED_ORDERED_PROPERTIES = ['<%- user.primaryKey.name %>', 'login', 'firstName', 'lastName', 'email', 'activated', 'langKey'];

@Controller('api')
@UseInterceptors(ClassSerializerInterceptor)
@ApiTags('public-user-controller')
export class PublicUserController {

  constructor(
    private readonly userService: UserService,
    private readonly headerUtil: HeaderUtil,
  ) {}

  /** Like the PublicUserResource of JHipster Spring Boot: the activated users, by their id and login, for authenticated users. */
  @Get('/users')
  @UseGuards(AuthGuard)
  @ApiOperation({ summary: 'Get the list of the activated users, by their id and login' })
  @ApiResponse({
      status: 200,
      description: 'List the activated users',
      type: PublicUserDTO,
      isArray: true,
  })
  async getAllPublicUsers(
    @Req() req: Request,
    @Pageable({ defaultSort: '<%- user.primaryKey.name %>,ASC', properties: ALLOWED_ORDERED_PROPERTIES, entityName: 'user' }) pageRequest: PageRequest,
  ): Promise<PublicUserDTO[]> {
      const [results, count] = await this.userService.findPublicUsers({
          skip: +pageRequest.page * pageRequest.size,
          take: +pageRequest.size,
          order: pageRequest.asOrder(),
      });
      this.headerUtil.addPaginationHeaders(req.res, new Page(results, count, pageRequest));
      return results;
  }

}
