import { Global, Module } from '@nestjs/common';
import { APP_FILTER, APP_INTERCEPTOR, APP_PIPE } from '@nestjs/core';

import { bodyValidationPipe } from './errors/body-validation.pipe.ts';
import { JsonBodyInterceptor } from './errors/json-body.interceptor.ts';
import { ProblemDetailsFilter } from './errors/problem-details.filter.ts';
import { HeaderUtil } from './header-util.ts';
<%_ if (authenticationTypeOauth2) { _%>
import { OAuth2Config } from '../auth/oauth2.config.ts';
<%_ } _%>

const providers = [HeaderUtil<%- authenticationTypeOauth2 ? ', OAuth2Config' : '' %>];

/**
 * The providers every module of the application uses, reading the configuration with ConfigService, like the beans of
 * JHipster Spring Boot: the headers of the responses<%- authenticationTypeOauth2 ? ', the endpoints of the OpenID Connect provider' : '' %>.
 */
@Global()
@Module({
  providers: [
    ...providers,
    // The global enhancers of the requests, like the handling of the requests of JHipster Spring Boot: the validation of
    // the bodies and parameters, a body of another content type than JSON refused, the errors as problem details.
    { provide: APP_PIPE, useFactory: bodyValidationPipe },
    { provide: APP_INTERCEPTOR, useClass: JsonBodyInterceptor },
    { provide: APP_FILTER, useClass: ProblemDetailsFilter },
  ],
  exports: providers,
})
export class CommonModule {}
