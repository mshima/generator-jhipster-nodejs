import { ArgumentMetadata, Injectable, ValidationPipe } from '@nestjs/common';

import { unreadableBodyException, validationException } from './problem.exception.ts';

/** The types of a body that is not an object: a text (a mail), a number, a boolean, a list. */
const NOT_OBJECTS: unknown[] = [String, Number, Boolean, Array];

/**
 * The ValidationPipe of the application, which refuses first a body that is not the object its route reads (a list, a
 * text, a number), like the unreadable body of JHipster Spring Boot: 400, not the validation errors of an empty object.
 * A request without a body gets here as an empty object, and is validated as one. A parameter of the path is left as its
 * text: the pipe of its route converts it (ParseLongPipe), and tells the value it got when it is not of its type.
 */
@Injectable()
export class BodyValidationPipe extends ValidationPipe {
  override async transform(value: unknown, metadata: ArgumentMetadata): Promise<unknown> {
    if (metadata.type === 'param') {
      return value;
    }
    // The whole body only (@Body()), not one of its properties (@Body('name')).
    if (metadata.type === 'body' && metadata.data === undefined && !NOT_OBJECTS.includes(metadata.metatype)) {
      if (value === null || typeof value !== 'object' || Array.isArray(value)) {
        throw unreadableBodyException();
      }
    }
    return super.transform(value, metadata);
  }
}

/** The validation of the requests of the application, the global pipe of the CommonModule. */
export const bodyValidationPipe = (): BodyValidationPipe =>
  new BodyValidationPipe({
    // The errors of the fields, like JHipster Spring Boot.
    exceptionFactory: validationException,
    // The body is an instance of its DTO without the properties the DTO does not declare, like JHipster Spring Boot
    // binds a request to its DTO and ignores the unknown properties: the declared properties without validation are
    // @Allow(). The instance keeps the properties excluded from the responses only (the password of a registration).
    whitelist: true,
    transform: true,
    // https://github.com/nestjs/nest/issues/10683#issuecomment-1349614194
    forbidUnknownValues: false,
    // The target of an error names the objectName of its field error (ValidationException), which is not sent: Nest
    // 12.2 leaves it out by default.
    validationError: { target: true },
  });
