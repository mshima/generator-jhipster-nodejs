import { ArgumentMetadata, BadRequestException, Injectable, PipeTransform } from '@nestjs/common';

/** The range of a Long of Java, the type of a numeric id of JHipster Spring Boot. */
const LONG_MIN = -(2n ** 63n);
const LONG_MAX = 2n ** 63n - 1n;
const INTEGER = /^[-+]?\d+$/;
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

/** The error of a parameter of the path that is not of its type, like the one of the conversion of Spring. */
const conversionFailure = (name: string | undefined, value: string): BadRequestException =>
  new BadRequestException(`Failed to convert '${name}' with value: '${value}'`);

/** A numeric id of the path, like a Long of JHipster Spring Boot: an integer within the range of a Long, else 400. */
@Injectable()
export class ParseLongPipe implements PipeTransform<string, number> {
  transform(value: string, { data }: ArgumentMetadata): number {
    if (!INTEGER.test(value) || BigInt(value) < LONG_MIN || BigInt(value) > LONG_MAX) {
      throw conversionFailure(data, value);
    }
    return Number(value);
  }
}

/** A UUID id of the path, like a UUID of JHipster Spring Boot, else 400. */
@Injectable()
export class ParseUuidPipe implements PipeTransform<string, string> {
  transform(value: string, { data }: ArgumentMetadata): string {
    if (!UUID.test(value)) {
      throw conversionFailure(data, value);
    }
    return value;
  }
}

/** The values of a boolean parameter, like the StringToBooleanConverter of Spring. */
const TRUE_VALUES = ['true', 'on', 'yes', '1'];
const FALSE_VALUES = ['false', 'off', 'no', '0'];

/**
 * An optional boolean parameter, like the conversion of Spring: true, on, yes, 1 or false, off, no, 0 in any case, else
 * 400 with the value. The ParseBoolPipe of Nest reads true and false only.
 */
@Injectable()
export class ParseBooleanPipe implements PipeTransform<unknown, boolean | undefined> {
  transform(value: unknown, { data }: ArgumentMetadata): boolean | undefined {
    if (value === undefined || value === '') {
      return undefined;
    }
    const text = typeof value === 'string' ? value.toLowerCase() : undefined;
    if (text !== undefined && TRUE_VALUES.includes(text)) {
      return true;
    }
    if (text !== undefined && FALSE_VALUES.includes(text)) {
      return false;
    }
    throw conversionFailure(data, typeof value === 'string' ? value : JSON.stringify(value));
  }
}
